# Used by compose.demo.yaml. Copy to .env.demo and run:
#   docker compose -p bloeki-demo --env-file .env.demo -f compose.demo.yaml up -d --build
# See docs/demo.md for the full write-up of what demo mode does and why.

# Required, same as the real deployment's .env - generate with:
#   openssl rand -hex 32
JWT_SECRET=

# How often the demo database resets (wipes every account/table/game and
# reseeds the fixed demo admin + a standing invite code). Minutes,
# clamped to [5, 1440] by the backend. Default: 60.
# DEMO_RESET_MINUTES=60

# Fixed demo login, printed on the demo site's own banner - not a secret,
# only override these if you're running more than one demo stack and want
# to tell them apart.
# DEMO_ADMIN_USERNAME=demo-admin
# DEMO_ADMIN_EMAIL=demo-admin@example.invalid
# DEMO_ADMIN_PASSWORD=bloeki-demo

# Standing invite code visitors use to self-register (also shown on the
# banner). Regenerated with every reset, so changing this mid-run only
# takes effect after the container restarts.
# DEMO_INVITE_CODE=demo

# Host-side ports. Defaults are deliberately different from both
# docker-compose.yml's (bloeki: 5174/15532) and songster's (5173/15432)
# defaults so a demo stack can run alongside a real bloeki AND a real
# songster stack on the same host without any override needed.
# FRONTEND_HOST_PORT=5175
# DB_HOST_PORT=15533

# Only used to build the clickable setup-token link in the backend's
# startup log - irrelevant in demo mode since the demo admin account
# always exists already, kept here only for parity with .env.example.
# FRONTEND_URL=http://localhost:5175

# How often the backend re-scans the generated demo clip directory.
# TRAILER_SCAN_INTERVAL_CRON=*/15 * * * *

# Length (seconds) of each synthetic demo clip the "demo-clips" one-shot
# service renders on first startup (see demo/generate-clips.sh). Default 25
# matches the real per-round trailer duration.
# TRAILER_DEMO_CLIP_SECONDS=25
