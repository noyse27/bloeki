{
  "name": "bloeki",
  "version": "0.1.0-beta",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "^10.9.0"
    }
  },
  "scripts": {
