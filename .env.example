# Used by docker-compose.yml (backend service). Copy to .env and set a real
# secret before running `docker compose up` - docker compose picks .env up
# automatically. The backend refuses to start without this.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: fixes the one-time setup token instead of letting the backend
# generate and log a random one on first start (see `docker compose logs
# backend` for "SETUP TOKEN" if you leave this unset). Only useful for
# scripted/unattended deploys.
# SETUP_TOKEN=

# Optional: only used to build the clickable setup-token link in that same
# log message. Set this to the address you'll actually open the wizard
# from if it's not this machine, e.g. http://192.168.1.50:5174.
# FRONTEND_URL=http://localhost:5174

# Host-side port for the frontend (nginx). Default 5174 is deliberately
# different from songster's 5173 so both stacks can run on the same Docker
# host at once without any override. Only needed if 5174 is also taken.
# FRONTEND_HOST_PORT=5174

# Host-side port for Postgres (debugging only - backend/migrate always
# reach it internally at db:5432 regardless of this). Default 15532 is
# deliberately different from songster's 15432 for the same reason. Only
# needed if 15532 is also taken.
# DB_HOST_PORT=15532

# How often the backend re-scans the Trailer-Snippet-Ordner (siehe
# tools/snippet-cutter und backend/src/services/trailerScan.ts). Default
# alle 15 Minuten - Standard-Cron-Syntax.
# TRAILER_SCAN_INTERVAL_CRON=*/15 * * * *

# Beta diagnostics: stores client/device debug events and server-side
# gameplay/socket events for later analysis. Enable only during beta/test
# sessions.
# BETA_DEBUG_LOGGING=true
# VITE_BETA_DEBUG_LOGGING=true
