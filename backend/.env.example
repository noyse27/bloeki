PORT=4000
DATABASE_URL=postgres://bloeki:bloeki@localhost:5432/bloeki
# Required: generate with `openssl rand -hex 32`. The backend refuses to
# start without a real secret here.
JWT_SECRET=
# Optional: fixes the one-time setup-wizard token instead of letting the
# backend generate and log a random one on first start.
# SETUP_TOKEN=
# Optional: builds the clickable link in that log message. Defaults to
# http://localhost:5173 (the Vite dev server).
# FRONTEND_URL=http://localhost:5173

# Trailer-Bibliothek: lokaler Ordner mit den von tools/snippet-cutter
# geschnittenen Snippets (siehe backend/src/services/trailerScan.ts). Im
# Docker-Compose-Setup wird das per Bind-Mount auf /data/clips gemountet
# (siehe docker-compose.yml) - fuer lokales `npm run dev` stattdessen auf
# einen echten lokalen Pfad zeigen.
TRAILER_CLIP_DIR=./bloeki-clips
# TRAILER_SCAN_INTERVAL_CRON=*/15 * * * *
